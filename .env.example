NEXT_PUBLIC_SUPABASE_URL=https://your-project-reference.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Configure these URLs for your site origin in the Supabase Auth redirect list:
# /auth/callback (customer), /admin/auth/callback, /admin/update-password.
# Admin profile deletion uses a guarded database RPC; it does not delete the
# customer account and does not require a service-role key.

# Server-only: 32 cryptographically random bytes encoded as base64.
# Required for the Admin email-link password-change flow; never use NEXT_PUBLIC_.
ADMIN_PASSWORD_FLOW_SECRET=
